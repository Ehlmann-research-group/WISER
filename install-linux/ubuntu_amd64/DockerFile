# syntax=docker/dockerfile:1

# Phase A: base OS + common build/runtime deps (Ubuntu 20.04, amd64)
# Build with: docker build --platform=linux/amd64 -t wiser-phasea:ubuntu20.04-amd64 -f docker/phaseA/Dockerfile .

FROM ubuntu:20.04

# Avoid tzdata interactive prompts during apt installs
ARG DEBIAN_FRONTEND=noninteractive

# Make shell strict for RUN lines
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

# Core tooling + common native build prereqs + common Qt runtime libs that often bite PySide2 apps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git \
    build-essential pkg-config \
    patchelf file \
    # Qt/OpenGL/EGL runtime deps
    libegl1 libgl1 \
    libgl1-mesa-dri \
    libglx0 \
    libglib2.0-0 libdbus-1-3 \
    libxkbcommon-x11-0 \
    libxcb1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-xinerama0 libxcb-xfixes0 \
    libfontconfig1 \
    strace pax-utils

WORKDIR /work

# Default command (can be overridden)
CMD ["bash"]
