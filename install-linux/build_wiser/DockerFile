# syntax=docker/dockerfile:1

# Phase B: build WISER + run PyInstaller, output to /out

ARG PHASEA_IMAGE=wiser-phasea:ubuntu20.04
FROM ${PHASEA_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

# 1) Copy lock + spec into image (as requested)
WORKDIR /work
COPY etc/prod-conda-lock.yml /work/prod-conda-lock.yml
COPY WISER-ubuntu.spec /work/WISER-ubuntu.spec
COPY . /work

RUN [ -d /work/dist ]  && rm -rf /work/dist  || true \
 && [ -d /work/build ] && rm -rf /work/build || true

# 2) Install micromamba (Docker-safe install: put binary on PATH)
# The install.sh puts micromamba in ~/.local/bin and relies on shell init,
# which is why `micromamba` isn't found during Docker RUN steps. :contentReference[oaicite:3]{index=3}
#
# Install the micromamba binary into /usr/local/bin instead.
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64)  mm_arch="linux-64" ;; \
      arm64)  mm_arch="linux-aarch64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar bzip2; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p "${MAMBA_ROOT_PREFIX}"; \
    curl -Ls "https://micro.mamba.pm/api/micromamba/${mm_arch}/latest" \
      | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba; \
    micromamba --version

# 3) Create env from conda-lock file
ARG ENV_NAME=wiser-prod
ENV WISER_ENV=prod
RUN micromamba create -y -n "${ENV_NAME}" -f /work/prod-conda-lock.yml \
 && micromamba clean -a -y

# 4) Run PyInstaller using the spec file
RUN micromamba run -n "${ENV_NAME}" pyinstaller /work/WISER-ubuntu.spec

# Ensure sqlite SONAME/aliases exist in the bundle (_internal)
RUN set -euxo pipefail; \
    internal_dir="$(find /work/dist -type d -name _internal -print -quit)"; \
    test -n "$internal_dir"; \
    cd "$internal_dir"; \
    # If only the fully-versioned file exists, create common linker names:
    if ls -1 libsqlite3.so.* >/dev/null 2>&1 && [ ! -e libsqlite3.so ]; then \
        target="$(ls -1 libsqlite3.so.* | head -n 1)"; \
        ln -sf "$target" libsqlite3.so; \
    fi; \
    # Also create libsqlite3.so.3 if needed (common DT_NEEDED)
    if [ -e libsqlite3.so ] && [ ! -e libsqlite3.so.3 ]; then \
        ln -sf libsqlite3.so libsqlite3.so.3; \
    fi; \
    ls -lah libsqlite3.so*

# Patch GDAL extension + libgdal to look in PyInstaller _internal first
RUN set -euxo pipefail; \
    internal_dir="$(find /work/dist -type d -name _internal -print -quit)"; \
    test -n "$internal_dir"; \
    find "$internal_dir" -type f \( -name "*_gdal*.so*" -o -name "libgdal.so*" \) -print \
      -exec patchelf --force-rpath --set-rpath '$ORIGIN' {} \;

# 4b) Patch libgdal.so.* to stop requiring sqlite via an absolute conda path ----
# If DT_NEEDED contains a slash, the dynamic loader treats it as a literal pathname
# (bypasses RPATH/RUNPATH/LD_LIBRARY_PATH searching), so we must rewrite it.
# patchelf --replace-needed rewrites DT_NEEDED. :contentReference[oaicite:1]{index=1}
RUN set -euxo pipefail; \
    internal_dir="$(find /work/dist -type d -name _internal -print -quit)"; \
    test -n "$internal_dir"; \
    gdal_so="$(find "$internal_dir" -maxdepth 1 -type f -name 'libgdal.so*' -print -quit)"; \
    test -n "$gdal_so"; \
    echo "Patching: $gdal_so"; \
    # Make sure libsqlite3.so.0 exists in _internal (what we want to depend on)
    cd "$internal_dir"; \
    if [ ! -e libsqlite3.so.0 ]; then \
      # Pick your existing versioned sqlite and link it to libsqlite3.so.0
      target="$(ls -1 libsqlite3.so.* | head -n 1)"; \
      ln -sf "$target" libsqlite3.so.0; \
    fi; \
    # Rewrite the absolute DT_NEEDED entry to the SONAME-style name
    patchelf --replace-needed \
      /opt/micromamba/envs/wiser-prod/lib/libsqlite3.so \
      libsqlite3.so.0 \
      "$gdal_so"; \
    # Sanity check: should no longer show the /opt/micromamba path
    readelf -d "$gdal_so" | grep -i sqlite

# 5) Put artifacts somewhere easy to export + tarball it (Linux-safe transfer)
RUN set -euxo pipefail; \
    mkdir -p /out; \
    if [ -d /work/dist ]; then cp -a /work/dist/. /out/; fi; \
    if [ -d /work/build ]; then cp -a /work/build/. /out/build/; fi; \
    ls -lah /out; \
    cd /out; \
    tar -C /out -czf /tmp/WISER.tar.gz .; \
    mv /tmp/WISER.tar.gz /out/WISER.tar.gz; \
    ls -lah /out/WISER.tar.gz

CMD ["bash"]
